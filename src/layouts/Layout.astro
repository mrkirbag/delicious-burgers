---
import { brand, brandCssVariablesStyle } from '@/data/brand';

interface Props {
  title?: string;
}

const { title = brand.name } = Astro.props;
---

<!doctype html>
<html lang={brand.locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/webp" href={brand.assets.favicon} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<style is:global set:html={brandCssVariablesStyle()}></style>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
