---
import OrderView from '@/components/orders/OrderView';
import PanelLayout from '@/layouts/PanelLayout.astro';

const session = Astro.locals.session!;
const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/panel/comandas');
}

const canDeliver =
  session.role === 'admin' ||
  session.role === 'cajero' ||
  session.role === 'mesero' ||
  session.role === 'cocina';
---

<PanelLayout title="Comanda | Panel">
  <div class="panel-page">
    <header class="panel-page__header">
      <p class="panel-page__eyebrow">Comandas</p>
      <h1 class="panel-page__title">Toma de pedido</h1>
    </header>

    <OrderView client:load orderId={id} canDeliver={canDeliver} />
  </div>
</PanelLayout>

<style>
  .panel-page__header {
    margin-bottom: 1.5rem;
  }

  .panel-page__eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .panel-page__title {
    margin: 0 0 0.75rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }
</style>
